<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.stats.LiarsDiceStatsFragment">

    <TextView
        android:id="@+id/tvStats2Players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="20dp"
        tools:text="@string/liarsDiceStatsFormat"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvStats3Players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        tools:text="@string/liarsDiceStatsFormat"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvStats4Players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        tools:text="@string/liarsDiceStatsFormat"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvStatsTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        tools:text="@string/liarsDiceTotalStatsFormat"
        android:textSize="18sp" />

</LinearLayout>
